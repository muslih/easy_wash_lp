# Salin file ini menjadi .env (untuk dijalankan di komputer)
# dan isi variabel yang sama di Vercel: Project → Settings → Environment Variables.

# Token dari @BotFather (bot @easywash_lp_bot). JANGAN dibagikan / di-commit.
TELEGRAM_BOT_TOKEN=ISI_TOKEN_DARI_BOTFATHER

# ID grup Easywash. Jika grup di-upgrade jadi supergroup, ID berubah (diawali -100…):
# ketik /id di grup untuk melihat ID terbaru.
TELEGRAM_GROUP_ID=-5330493853

# Kode rahasia acak untuk mengamankan webhook (huruf/angka/_/-, min. 16 karakter)
TELEGRAM_WEBHOOK_SECRET=ganti-dengan-kode-acak-panjang

# GitHub fine-grained token: hanya repo easy_wash_lp, permission "Contents: Read and write"
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=muslih/easy_wash_lp
GITHUB_BRANCH=master
# Kosongkan karena proyek Astro ada di root repo
GITHUB_PROJECT_DIR=

# Alamat website (untuk tombol "Buka website" & webhook)
SITE_URL=https://easy-wash-bjm.vercel.app
