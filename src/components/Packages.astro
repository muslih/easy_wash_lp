---
import { packages, formatRupiah } from '../data/config';
import Icon from './Icon.astro';
---

<section id="paket" class="page-width scroll-mt-20 py-14 md:scroll-mt-24 md:py-16">
  <div class="text-center">
    <p class="eyebrow">Paket laundry</p>
    <h2 class="section-title mt-3">Ada paket untuk setiap kebutuhan.</h2>
    <p class="mt-3 text-sm text-muted-foreground">
      Dari cucian sehari-hari hingga kebutuhan mendadak, kami bantu bereskan.
    </p>
    <p class="mt-2 text-xs text-muted-foreground">Paket, harga, dan durasi berikut masih contoh.</p>
  </div>

  <div class="mt-9 grid gap-5 md:grid-cols-3">
    {
      packages.map((pkg, index) => (
        <article class:list={['service-card', { featured: pkg.featured }]}>
          {pkg.badge && (
            <span class="absolute top-5 right-5 rounded-full bg-background px-3 py-1.5 text-[10px] font-bold text-primary uppercase">
              {pkg.badge}
            </span>
          )}
          <div class="icon-box">
            <Icon name={pkg.icon} size={25} strokeWidth={1.5} />
          </div>
          <h3 class="mt-5 text-xl font-bold">{pkg.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground md:min-h-12">{pkg.description}</p>
          <div class="mt-5">
            <span class="text-3xl font-bold">{formatRupiah(pkg.price)}</span>
            <span class="text-sm text-muted-foreground"> / kg</span>
          </div>
          <div class="mt-3 flex items-center gap-2 text-xs text-muted-foreground">
            <Icon name="clock" size={14} />
            Estimasi {pkg.duration}
          </div>
          <div class="my-5 border-t border-border" />
          <ul class="mb-7 space-y-3">
            {pkg.features.map((feature) => (
              <li class="flex items-center gap-2 text-sm">
                <Icon name="check" size={15} class="shrink-0 text-primary" />
                {feature}
              </li>
            ))}
          </ul>
          <button
            type="button"
            class:list={['btn mt-auto h-12 w-full', pkg.featured ? 'btn-action' : 'btn-outline']}
            data-package={index}
          >
            Pilih Paket
            <Icon name="arrow-right" class="ml-auto" />
          </button>
        </article>
      ))
    }
  </div>

  <p class="mt-5 text-center text-xs text-muted-foreground">
    Berat dan total akhir dikonfirmasi setelah pakaian ditimbang.
  </p>
</section>
