---
import Icon from './Icon.astro';
import { content } from '../data/config';
const { steps, stepsSection } = content;
---

<section id="cara-pesan" class="scroll-mt-16 bg-muted py-14 md:scroll-mt-20">
  <div class="page-width">
    <div class="text-center">
      <p class="eyebrow">{stepsSection.eyebrow}</p>
      <h2 class="section-title mt-3">{stepsSection.title}</h2>
    </div>
    <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-9">
      {
        steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="pt-1 text-sm font-bold text-primary">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <Icon name={step.icon} size={25} strokeWidth={1.5} class="mb-4 text-primary" />
              <h3 class="font-bold">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
