---
import { Image } from 'astro:assets';
import { heroImage } from '../data/images';
import { content } from '../data/config';
const h = content.hero;
import Icon from './Icon.astro';
---

<section class="relative overflow-hidden bg-muted">
  <Image
    src={heroImage}
    alt={`Ruang laundry ${content.business.name}`}
    widths={[640, 960, 1280, 1536]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover object-[72%_bottom] opacity-35 md:object-[center_60%] md:opacity-100 dark:opacity-25 dark:md:opacity-70"
    loading="eager"
    fetchpriority="high"
  />
  <!-- Gradasi agar teks tetap terbaca di layar kecil -->
  <div class="absolute inset-0 bg-gradient-to-b from-muted/90 via-muted/60 to-transparent md:hidden dark:from-background/95 dark:via-background/80 dark:to-background/40" aria-hidden="true"></div>
  <!-- Mode gelap di layar besar: gelapkan sisi kiri foto agar teks tetap terbaca -->
  <div class="absolute inset-0 hidden bg-gradient-to-r from-background via-background/85 to-background/10 dark:md:block" aria-hidden="true"></div>

  <div class="page-width relative flex flex-col items-start pt-10 pb-14 sm:pt-14 md:min-h-[560px] md:justify-center md:py-16">
    {
      h.badge && (
        <div class="inline-flex items-center gap-2 rounded-full bg-secondary px-3 py-2 text-xs font-medium text-primary">
          <Icon name="sparkles" size={14} />
          {h.badge}
        </div>
      )
    }

    <h1 class="mt-[18px] mb-5 max-w-[560px] text-[clamp(2.25rem,9vw,3.875rem)] leading-[1.15] font-extrabold">
      <span class="text-primary">{h.wordmark1}<span class="text-brand-yellow">{h.wordmark2}</span></span><br />
      {h.titleLine1}
      {h.titleLine2 && (<><br /><span class="text-primary">{h.titleLine2}</span></>)}
    </h1>

    <p class="max-w-[420px] text-base leading-[1.85] text-foreground md:text-muted-foreground">
      {h.description}
    </p>

    <div class="mt-7 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href="#paket" class="btn btn-action btn-lg w-full sm:w-auto">
        {h.primaryCta}
        <Icon name="arrow-right" />
      </a>
      <button type="button" class="btn btn-outline btn-lg w-full sm:w-auto" data-action="check">
        {h.secondaryCta}
        <Icon name="package-check" />
      </button>
    </div>

    {
      h.note && (
        <div class="mt-6 flex items-center gap-2 text-xs text-muted-foreground">
          <Icon name="shield-check" size={15} class="text-primary" />
          {h.note}
        </div>
      )
    }
  </div>
</section>
