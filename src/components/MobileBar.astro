---
import Icon from './Icon.astro';
---

<!-- Tombol cepat di bagian bawah layar, hanya tampil di HP -->
<div
  class="fixed inset-x-0 bottom-0 z-30 border-t border-border bg-background/95 px-4 pt-3 backdrop-blur md:hidden"
  style="padding-bottom: calc(12px + env(safe-area-inset-bottom));"
>
  <div class="mx-auto flex max-w-md gap-2">
    <button type="button" class="btn btn-outline h-12 flex-1" data-action="check">
      <Icon name="package-check" />
      Cek Status
    </button>
    <a href="#paket" class="btn btn-action h-12 flex-[1.4]">
      <Icon name="message-circle" />
      Pesan Sekarang
    </a>
  </div>
</div>
