---
import Sheet from './Sheet.astro';
---

<Sheet id="order" title="Pesan laundry" description="Lengkapi detail cucianmu untuk dikirim ke Easywash.">
  <form id="order-form" class="form-grid">
    <label>
      Nama
      <input name="name" maxlength="100" placeholder="Nama lengkap" autocomplete="name" required />
    </label>
    <label>
      Nomor WhatsApp
      <input name="phone" type="tel" inputmode="tel" pattern="[+0-9\s\-]{9,20}" placeholder="08xxxxxxxxxx" autocomplete="tel" required />
    </label>
    <div class="grid grid-cols-1 gap-4 min-[400px]:grid-cols-2">
      <label>
        Perkiraan berat (kg)
        <input name="weight" type="number" inputmode="decimal" min="1" max="100" step="0.5" value="3" required />
      </label>
      <label>
        Penyerahan
        <select name="delivery">
          <option>Antar ke laundry</option>
          <option>Tanyakan penjemputan</option>
        </select>
      </label>
    </div>
    <label>
      Alamat / catatan
      <textarea name="notes" maxlength="1000" rows="2" autocomplete="street-address"></textarea>
    </label>
    <div class="order-summary flex justify-between text-sm">
      <span>Estimasi total</span>
      <strong id="total"></strong>
    </div>
    <p class="text-xs text-muted-foreground">Harga contoh. Total akhir dikonfirmasi melalui WhatsApp.</p>
    <button type="submit" class="btn btn-action btn-lg w-full">Lanjut ke WhatsApp →</button>
  </form>
</Sheet>

<Sheet id="check" title="Tanya status cucian" description="Kirim pertanyaan ke Easywash melalui WhatsApp.">
  <form id="check-form" class="form-grid">
    <label>
      Nama pemesan
      <input name="name" maxlength="100" autocomplete="name" required />
    </label>
    <label>
      Nomor pesanan (opsional)
      <input name="id" maxlength="50" placeholder="EW-001" />
    </label>
    <button type="submit" class="btn btn-action btn-lg w-full">Tanya lewat WhatsApp</button>
  </form>
</Sheet>
