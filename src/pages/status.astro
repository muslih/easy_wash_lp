---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Notice from '../components/Notice.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { statuses, site } from '../data/config';
---

<Layout
  title={`Kirim Status Pelanggan — ${site.name}`}
  description={`Siapkan dan kirim pembaruan status cucian ${site.name} melalui WhatsApp.`}
>
  <main class="page-width py-6 pb-[calc(32px+env(safe-area-inset-bottom))] sm:py-10">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="inline-flex min-h-10 items-center gap-2 text-sm text-muted-foreground hover:text-primary">
        <Icon name="arrow-left" size={16} />
        Kembali ke {site.name}
      </a>
      <ThemeToggle />
    </div>

    <div class="mx-auto mt-6 max-w-xl sm:mt-12">
      <span class="icon-box"><Icon name="droplets" /></span>
      <h1 class="section-title mt-6">Kirim status pelanggan</h1>
      <p class="mt-3 mb-8 text-sm text-muted-foreground">Kabar kecil untuk cucian yang sedang kami rawat.</p>

      <form id="status-form" class="form-grid">
        <div class="grid gap-4 sm:grid-cols-2">
          <label>
            Nama pelanggan
            <input name="name" maxlength="100" placeholder="Nama pelanggan" required />
          </label>
          <label>
            WhatsApp pelanggan
            <input name="phone" type="tel" inputmode="tel" placeholder="08xxxxxxxxxx" required />
          </label>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <label>
            Nomor pesanan
            <input name="id" maxlength="50" placeholder="EW-001" required />
          </label>
          <label>
            Status cucian
            <select name="status">
              {statuses.map((s, i) => <option selected={i === 0}>{s}</option>)}
            </select>
          </label>
        </div>
        <label>
          Catatan (opsional)
          <textarea name="notes" maxlength="1000" rows="2" placeholder="Tambahkan informasi untuk pelanggan"></textarea>
        </label>

        <div class="order-summary">
          <p class="mb-3 text-xs font-semibold text-primary">Pesan untuk pelanggan</p>
          <p id="status-preview" class="text-sm leading-relaxed break-words whitespace-pre-line" aria-live="polite"></p>
        </div>

        <button type="submit" class="btn btn-action btn-lg w-full">
          <Icon name="message-circle" />
          Kirim lewat WhatsApp
        </button>
        <p class="text-center text-xs text-muted-foreground">
          Pesan perlu dikirim di WhatsApp. Status tidak disimpan di website.
        </p>
      </form>
    </div>
  </main>
  <Notice />
</Layout>

<script>
  import { initDialogs, initStatusPage } from '../scripts/whatsapp';
  initDialogs();
  initStatusPage();
</script>
