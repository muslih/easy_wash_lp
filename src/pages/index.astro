---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Packages from '../components/Packages.astro';
import Steps from '../components/Steps.astro';
import StatusCta from '../components/StatusCta.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Dialogs from '../components/Dialogs.astro';
import Notice from '../components/Notice.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Features />
    <Packages />
    <Steps />
    <StatusCta />
  </main>
  <Footer />
  <MobileBar />
  <Dialogs />
  <Notice />
</Layout>

<script>
  import { initDialogs, initHomePage } from '../scripts/whatsapp';
  initDialogs();
  initHomePage();
</script>
