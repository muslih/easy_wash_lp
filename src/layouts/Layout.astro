---
import '../styles/global.css';
import { content } from '../data/config';
import { heroImage } from '../data/images';
import { getImage } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
}

const { title = content.seo.title, description = content.seo.description } = Astro.props;
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'jpg' });
const ogUrl = Astro.site ? new URL(ogImage.src, Astro.site).href : ogImage.src;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body class="min-h-dvh">
    <slot />
  </body>
</html>
